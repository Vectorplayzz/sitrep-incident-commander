# Copy to .env and fill in. Never commit .env.
#
# Model provider. SITREP is provider-agnostic: any OpenAI-compatible
# endpoint works. The defaults target Ollama Cloud so the whole agent runs
# on open-weight models.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Daytona sandbox. The key needs BOTH sandbox and snapshot permissions --
# TrueForge builds a snapshot on first configuration.
DAYTONA_API_KEY=
